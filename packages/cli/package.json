{
  "name": "@interwebalchemy/engram-cli",
  "version": "0.1.0",
  "description": "Agent-facing CLI for Engram tools and Agent Skills workflows",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "engram": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@interwebalchemy/engram-core": "*"
  },
  "keywords": [
    "engram",
    "agent",
    "skills",
    "cli"
  ],
  "license": "GPL-3.0-only"
}
