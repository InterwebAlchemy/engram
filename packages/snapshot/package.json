{
  "name": "@interwebalchemy/engram-snapshot",
  "version": "0.1.0",
  "description": "Snapshot and restore tooling for Engram vault state",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "engram-snapshot": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "engram",
    "snapshot",
    "restore",
    "vault",
    "backup"
  ],
  "license": "GPL-3.0-only"
}
