{
  "name": "@interwebalchemy/engram-onboarding",
  "version": "0.1.0",
  "description": "Interactive CLI for configuring a new Engram vault and local harness setup",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "onboarding": "dist/index.js"
  },
  "files": [
    "dist",
    "obsidian-plugin"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-plugin-assets.mjs",
    "clean": "rm -rf dist obsidian-plugin",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@interwebalchemy/engram-cli": "*",
    "@interwebalchemy/engram-snapshot": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "engram",
    "cli",
    "mcp",
    "obsidian"
  ],
  "license": "GPL-3.0-only"
}
