{
  "name": "@interwebalchemy/engram-core",
  "version": "0.1.0",
  "description": "Portable AI knowledge store — core library for LLM conversation memory management",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "gpt-tokenizer": "2.9.0",
    "yaml": "2.8.3"
  },
  "keywords": [
    "llm",
    "memory",
    "obsidian",
    "vault",
    "ai",
    "mcp"
  ],
  "license": "GPL-3.0-only"
}
